{
  "schema_version": 2,
  "processing": {
    "codex_service_tier": "default",
    "codex_fast_mode": false,
    "codex_ultrafast_mode": false,
    "claude_fast_mode": false,
    "claude_disable_fast_mode": "1"
  },
  "defaults": {
    "codex": "orbyn-lead",
    "claude": "orbyn-lead"
  },
  "agents": {
    "orbyn-lead": {
      "tier": "lead",
      "purpose": "Planning, architecture, consequential review, security and ambiguous diagnosis",
      "codex": {
        "model": "gpt-6.1-sol",
        "effort": "medium"
      },
      "claude": {
        "model": "opus",
        "effort": "medium"
      }
    },
    "orbyn-worker": {
      "tier": "worker",
      "purpose": "Assigned implementation, tests and cleanup",
      "codex": {
        "model": "gpt-6.1-terra",
        "effort": "medium"
      },
      "claude": {
        "model": "sonnet",
        "effort": "medium"
      }
    },
    "orbyn-scout": {
      "tier": "scout",
      "purpose": "Bounded mechanical search, extraction and named checks that need no judgement",
      "codex": {
        "model": "gpt-6-luna",
        "effort": "medium"
      },
      "claude": {
        "model": "haiku",
        "effort": "medium"
      }
    }
  },
  "delegation": {
    "max_children": 2,
    "max_depth": 1,
    "read_only_children_extra": 0
  },
  "routing": {
    "lead": "lead",
    "architect": "lead",
    "reviewer": "lead",
    "security": "lead",
    "security_verifier": "lead",
    "security_engineer": "lead",
    "engineer": "worker",
    "engineer_complex": {
      "claude": "worker",
      "codex": "lead"
    },
    "investigator": "worker",
    "verifier": "worker",
    "mechanical": "scout",
    "tiny_edit": "scout"
  },
  "escalation": {
    "scout": "worker",
    "worker": "lead"
  },
  "allowed_models": {
    "claude": {
      "lead": [
        "opus",
        "claude-opus-5-5"
      ],
      "worker": [
        "sonnet",
        "claude-sonnet-5-5"
      ],
      "scout": [
        "haiku",
        "claude-haiku-5-5"
      ]
    },
    "codex": {
      "lead": [
        "gpt-6.1-sol"
      ],
      "worker": [
        "gpt-6.1-terra"
      ],
      "scout": [
        "gpt-6-luna"
      ]
    }
  },
  "effort_caps": {
    "gpt-6.1-sol": "medium",
    "gpt-6.1-terra": "medium",
    "sonnet": "medium",
    "fable": "medium"
  },
  "claude_minimum_versions": {
    "opus": "2.1.280",
    "sonnet": "2.1.284",
    "haiku": "2.1.293"
  },
  "human_only": {
    "codex": {
      "model": "gpt-6-astra"
    },
    "claude": {
      "model": "fable",
      "effort_cap": "medium"
    }
  }
}

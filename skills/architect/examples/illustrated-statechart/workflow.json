{
  "title": "From a question to a clean handoff",
  "subtitle": "Our engineering workflow: evidence moves the work forward; authority controls external effects.",
  "evidence": "Policy illustration derived from current Orbyn workflow, PR delivery/iteration and task-closeout guidance. This is an authored overview, not an executed model check or a live task status. Source, commit, push, PR and resources remain independently verified records. Loops show selected recovery paths; the full workflow contains additional blocked, pause and cancellation cases. Retained/retired are closeout dispositions, not proof of successful delivery. This is a change-delivery overview; read-only tasks do not require building or publication, and routine work uses proportional investigation and optional isolation.",
  "width": 2100,
  "height": 2450,
  "nodes": [
    {
      "id": "scope",
      "title": "01 / Establish the task",
      "x": 120,
      "y": 330,
      "width": 450,
      "height": 270,
      "lines": [
        "Lead: resolve target and instructions.",
        "Confirm benefit, scope and authority."
      ],
      "parent": "understand",
      "start": true
    },
    {
      "id": "research",
      "title": "02 / Understand and design",
      "x": 700,
      "y": 330,
      "width": 450,
      "height": 270,
      "lines": [
        "Trace source; reproduce the real problem.",
        "Choose owners, boundaries and focused checks."
      ],
      "parent": "understand"
    },
    {
      "id": "build",
      "title": "03 / Build the candidate",
      "x": 1280,
      "y": 330,
      "width": 450,
      "height": 270,
      "lines": [
        "Use an owned checkout; isolate when needed.",
        "Delegate bounded slices when useful."
      ],
      "parent": "understand"
    },
    {
      "id": "verify",
      "title": "04 / Inspect and verify",
      "x": 1280,
      "y": 800,
      "width": 450,
      "height": 270,
      "lines": [
        "Lead reviews the actual diff and result.",
        "Check failure cases and relevant consumers."
      ],
      "parent": "prepare"
    },
    {
      "id": "commit",
      "title": "05 / Verify the commit",
      "x": 700,
      "y": 800,
      "width": 450,
      "height": 270,
      "lines": [
        "Stage only intended, verified changes.",
        "Read back successful HEAD and tree."
      ],
      "parent": "prepare"
    },
    {
      "id": "push",
      "title": "06 / Observe the pushed ref",
      "x": 120,
      "y": 800,
      "width": 450,
      "height": 270,
      "lines": [
        "Use the authorized destination and ref.",
        "Remote head must match the intended commit."
      ],
      "parent": "prepare"
    },
    {
      "id": "pr",
      "title": "07 / Open and review the PR",
      "x": 120,
      "y": 1270,
      "width": 450,
      "height": 270,
      "lines": [
        "Read back PR identity, head and base.",
        "Review and CI are separate gates."
      ],
      "parent": "deliver"
    },
    {
      "id": "merge",
      "title": "08 / Observe the landing",
      "x": 700,
      "y": 1270,
      "width": 450,
      "height": 270,
      "lines": [
        "Merge only within existing authorization.",
        "Read back landing, checks and local main."
      ],
      "parent": "deliver"
    },
    {
      "id": "closeout",
      "title": "09 / Reconcile resources",
      "x": 1280,
      "y": 1270,
      "width": 450,
      "height": 270,
      "lines": [
        "Inspect later source, owners and active use.",
        "Preserve artifacts; verify recovery."
      ],
      "parent": "deliver"
    },
    {
      "id": "retire",
      "title": "Retired with recovery",
      "x": 1280,
      "y": 1740,
      "width": 450,
      "height": 270,
      "lines": [
        "Only the approved exact inactive paths.",
        "Use supported removal and verify readback."
      ],
      "parent": "disposition",
      "terminal": true
    },
    {
      "id": "hold",
      "title": "Retained for a reason",
      "x": 700,
      "y": 1740,
      "width": 450,
      "height": 270,
      "lines": [
        "Keep source, evidence and live previews.",
        "Name an owner, next action and review trigger."
      ],
      "parent": "disposition",
      "terminal": true
    }
  ],

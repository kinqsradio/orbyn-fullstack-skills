  "files": {
    "slug.py": "\"\"\"Turn titles into URL slugs.\"\"\"\nimport re\n\n\ndef slugify(text, max_length=None):\n    text = re.sub(r'[^a-z0-9]+', '-', text.lower()).strip('-')\n    if max_length is not None and len(text) > max_length:\n        cut = text[:max_length]\n        if text[max_length] != '-' and '-' in cut:\n            cut = cut.rsplit('-', 1)[0]\n        text = cut.strip('-')\n    return text\n",
    "tests/test_slug.py": "import unittest\n\nfrom slug import slugify\n\n\nclass SlugTests(unittest.TestCase):\n    def test_basic(self):\n        self.assertEqual(slugify('Hello, World!'), 'hello-world')\n\n    def test_collapses_separators(self):\n        self.assertEqual(slugify('a  --  b'), 'a-b')\n\n    def test_max_length_cuts_on_hyphen(self):\n        self.assertEqual(slugify('Hello big world', 9), 'hello-big')\n\n    def test_max_length_none_is_unchanged(self):\n        self.assertEqual(slugify('Hello big world', None), 'hello-big-world')\n"
